# DesignBySari – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# `.env.local` wird nie ins Repository übernommen. Hier stehen nie echte Zugangsdaten.
# Ohne jede Variable läuft die Vorschauversion vollständig (ohne KI, Datenbank, Zahlungen).

# --- Website ---
# Öffentliche Basis-URL (ohne Schrägstrich am Ende), für Sitemap und Vorschaubilder
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Erst zum offiziellen Start auf true setzen; sonst bleibt die Seite aus Suchmaschinen
# SITE_INDEXABLE=false

# --- KI (nur serverseitig, nie NEXT_PUBLIC_) ---
# Anbieter für alle drei Schritte. Derzeit ist KEIN Anbieter eingetragen,
# jeder Wert außer einem eingetragenen Anbieter lässt die KI ausgeschaltet.
# AI_PROVIDER=disabled
# Optional je Schritt abweichend:
# AI_ANALYSIS_PROVIDER=
# AI_PLANNING_PROVIDER=
# AI_IMAGE_PROVIDER=
# Schlüssel des späteren Anbieters, Name je nach Anbieter, z. B.:
# EXAMPLE_API_KEY=
# Limits und Kostenkontrolle (Standardwerte in Klammern):
# AI_MAX_REQUESTS_PER_HOUR_PER_CLIENT=5
# AI_MAX_DESIGNS_PER_DAY=50
# AI_MAX_COST_USD_CENTS_PER_REQUEST=100
# AI_MAX_COST_USD_CENTS_PER_DAY=1000
# AI_TIMEOUT_MS=90000
# Nutzungszähler (Pflicht, sonst bleibt die KI aus). Für den Livebetrieb ein
# gemeinsamer, dauerhafter Zähler. Derzeit ist keiner eingetragen.
# AI_USAGE_STORE=
# Nur für lokale Tests: In-Memory-Zähler, nie im Produktionsmodus (NODE_ENV=production)
# AI_USAGE_STORE=memory
# AI_ALLOW_IN_MEMORY_LIMITS=true

# --- Produktquellen (kommagetrennt, derzeit keine eingetragen) ---
# PRODUCT_SOURCES=

# --- Supabase (Konten, Projekte, Fotos) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Zahlungen (Stripe, standardmäßig aus) ---
# PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Live-Schlüssel werden nur mit dieser zusätzlichen Freigabe akzeptiert:
# PAYMENTS_ALLOW_LIVE=false
