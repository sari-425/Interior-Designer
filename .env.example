# DesignBySari – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# `.env.local` wird nie ins Repository übernommen.
#
# Phase 1 benötigt keine Umgebungsvariablen. Die folgenden Einträge
# werden in den jeweiligen Phasen aktiviert.

# Öffentliche Basis-URL der App (ohne Schrägstrich am Ende)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: KI-Bildgenerierung (nur serverseitig, nie NEXT_PUBLIC_) ---
# Erlaubt: mock | <anbieter>. Standard ist "mock" (kostenlos).
# AI_PROVIDER=mock
# AI_PROVIDER_API_KEY=

# --- Phase 4: Supabase ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 5: Stripe (zuerst Testmodus) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
